<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProfileKit.App.Pages.CapturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ProfileKit.App"
    xmlns:s="using:ProfileKit.App.Services">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="{l:Loc Key=ui-capture-title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:Loc Key=ui-capture-intro}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="SourceBox" Header="{l:Loc Key=ui-capture-source}" MinWidth="240" />
            <Button Content="{l:Loc Key=ui-select-all}" Click="SelectAll_Click" VerticalAlignment="Bottom" />
            <Button Content="{l:Loc Key=ui-select-none}" Click="SelectNone_Click" VerticalAlignment="Bottom" />
            <Button Content="{l:Loc Key=ui-select-windows}" Click="SelectWindows_Click" VerticalAlignment="Bottom" />
            <Button x:Name="InstalledButton" Content="{l:Loc Key=ui-select-installed}" Click="SelectInstalled_Click" VerticalAlignment="Bottom" />
            <ProgressRing x:Name="InventoryRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Bottom" />
        </StackPanel>

        <ListView x:Name="ModuleList" Grid.Row="2" SelectionMode="None" BorderThickness="1"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="4">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="s:SelectableItem">
                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                        <StackPanel>
                            <TextBlock Text="{x:Bind Title}" />
                            <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" Header="{l:Loc Key=ui-capture-folder}" />
            <Button Grid.Column="1" Content="{l:Loc Key=ui-browse}" Click="Browse_Click" VerticalAlignment="Bottom" />
            <TextBox Grid.Column="2" x:Name="NameBox" Header="{l:Loc Key=ui-capture-name}" />
            <CheckBox Grid.Column="3" x:Name="ZipBox" Content="{l:Loc Key=ui-capture-zip}" VerticalAlignment="Bottom" />
            <Button Grid.Column="4" Content="{l:Loc Key=ui-capture-start}" Click="Start_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" />
        </Grid>
    </Grid>
</Page>
