<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProfileKit.App.Pages.LearnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ProfileKit.App">
    <ScrollViewer>
        <StackPanel Spacing="8" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="{l:Loc Key=ui-learn-title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:Loc Key=ui-learn-intro}" TextWrapping="Wrap" />

            <TextBlock Text="{l:Loc Key=ui-learn-step1}" Style="{StaticResource SectionTitle}" />
            <CheckBox x:Name="MachineBox" Content="{l:Loc Key=ui-learn-machine}" />
            <TextBox x:Name="ExcludeBox" Header="{l:Loc Key=ui-learn-exclude}" PlaceholderText="%APPDATA%\Laut\**;HKCU\Software\Laut\**" />
            <Button Content="{l:Loc Key=ui-learn-start}" Click="Start_Click" Style="{StaticResource AccentButtonStyle}" />

            <TextBlock Text="{l:Loc Key=ui-learn-step2}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{l:Loc Key=ui-learn-step2-text}" TextWrapping="Wrap" />
            <Button Content="{l:Loc Key=ui-learn-diff}" Click="Diff_Click" />

            <TextBlock Text="{l:Loc Key=ui-learn-step3}" Style="{StaticResource SectionTitle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NameBox" Header="{l:Loc Key=ui-learn-name}" TextChanged="Name_Changed" />
                <TextBox Grid.Column="1" x:Name="IdBox" Header="{l:Loc Key=ui-learn-id}" />
                <TextBox Grid.Column="2" x:Name="WingetBox" Header="{l:Loc Key=ui-learn-winget}" />
            </Grid>
            <CheckBox x:Name="ForceBox" Content="{l:Loc Key=ui-learn-force}" />
            <Button Content="{l:Loc Key=ui-learn-stop}" Click="Stop_Click" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
