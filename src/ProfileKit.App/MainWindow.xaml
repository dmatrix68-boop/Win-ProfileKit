<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ProfileKit.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ProfileKit.App"
    Title="Win-ProfileKit">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="AdminBar" Grid.Row="0" Severity="Warning" IsClosable="True" IsOpen="False"
                 Title="{l:Loc Key=ui-admin-title}" Message="{l:Loc Key=ui-admin-banner}">
            <InfoBar.ActionButton>
                <Button Content="{l:Loc Key=ui-restart-admin}" Click="RestartAdmin_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <NavigationView x:Name="Nav" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        PaneDisplayMode="Left" OpenPaneLength="220" SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{l:Loc Key=ui-nav-overview}" Tag="overview" Icon="Home" />
                <NavigationViewItem Content="{l:Loc Key=ui-nav-capture}" Tag="capture" Icon="Save" />
                <NavigationViewItem Content="{l:Loc Key=ui-nav-apply}" Tag="apply" Icon="Import" />
                <NavigationViewItem Content="{l:Loc Key=ui-nav-learn}" Tag="learn" Icon="Edit" />
                <NavigationViewItem Content="{l:Loc Key=ui-nav-ai}" Tag="ai" Icon="Find" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="{l:Loc Key=ui-nav-settings}" Tag="settings" Icon="Setting" />
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" Padding="24,16,24,8" />
        </NavigationView>

        <Expander x:Name="LogExpander" Grid.Row="2" IsExpanded="False" Margin="8,0,8,8"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{l:Loc Key=ui-log}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <ProgressRing x:Name="BusyRing" IsActive="False" Width="16" Height="16" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Expander.Header>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="LogScroll" Height="180" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
                </ScrollViewer>
                <StackPanel Grid.Column="1" Spacing="8">
                    <Button x:Name="CancelButton" Content="{l:Loc Key=ui-cancel}" IsEnabled="False" Click="Cancel_Click" />
                    <Button Content="{l:Loc Key=ui-clear}" Click="Clear_Click" />
                </StackPanel>
            </Grid>
        </Expander>
    </Grid>
</Window>
