<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(PkTfm)-windows</TargetFramework>
    <RootNamespace>ProfileKit.Cli</RootNamespace>
    <AssemblyName>profilekit</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProfileKit.Core\ProfileKit.Core.csproj" />
    <ProjectReference Include="..\ProfileKit.Windows\ProfileKit.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Regelkatalog neben die EXE legen -->
    <None Include="..\..\rules\**\*.json;..\..\rules\*.list" LinkBase="rules" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
