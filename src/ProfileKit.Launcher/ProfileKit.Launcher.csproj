<Project Sdk="Microsoft.NET.Sdk">
  <!-- Starter im Root der Release-Pakete: startet app\profilekit-gui.exe. Zielt auf .NET Framework 4.8,
       das in Windows 10/11 enthalten ist – läuft also auch ohne .NET-10-Runtime und ist nur wenige KB groß.
       Nur für die Release-Pakete (release.yml), deshalb nicht in ProfileKit.sln. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>profilekit-gui</AssemblyName>
    <ApplicationIcon>..\..\assets\icon\profilekit.ico</ApplicationIcon>
    <RootNamespace>ProfileKit.Launcher</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
